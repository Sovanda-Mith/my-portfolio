# Environment Variables
# Copy this file to `.env.local` and fill in real values.
#   cp .env.example .env.local
#
# `.env` and `.env*.local` are gitignored — never commit real secrets.

# rss2json API key — used by components/MediumArticles.tsx to fetch
# Medium articles (https://medium.com/@sovanda_m) for the /blog page.
# Get one at https://rss2json.com/
NEXT_PUBLIC_RSS_API_KEY=your_rss2json_api_key_here
